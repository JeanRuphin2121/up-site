---
import Icone from './Icone.astro';
import { contact } from '../data/site';

const message = encodeURIComponent(
  "Bonjour, je vous contacte depuis votre site internet. J'aimerais avoir des informations."
);
const lien = `https://wa.me/${contact.whatsapp}?text=${message}`;
---

<a
  href={lien}
  target="_blank"
  rel="noopener noreferrer"
  data-suivi="whatsapp"
  class="fixed bottom-5 right-5 z-50 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/25 transition-transform hover:scale-105 sm:bottom-7 sm:right-7"
  aria-label="Nous écrire sur WhatsApp"
>
  <Icone nom="whatsapp" class="h-7 w-7" />
</a>

<script>
  // Remonte un événement à Cloudflare Web Analytics quand quelqu'un clique.
  // Sans cookie, donc sans bandeau de consentement à afficher.
  document.querySelector('[data-suivi="whatsapp"]')?.addEventListener('click', () => {
    // @ts-ignore — l'objet est injecté par le script Cloudflare.
    window.__cfBeacon && navigator.sendBeacon?.('/cdn-cgi/rum?clic=whatsapp');
  });
</script>
