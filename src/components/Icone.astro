---
/**
 * Pictogrammes tracés d'après ceux des kakémonos.
 * Trait uniquement (pas d'aplat) pour rester lisible dans les médaillons.
 */
interface Props {
  nom:
    | 'education'
    | 'insertion'
    | 'social'
    | 'commerce'
    | 'entretien'
    | 'monture'
    | 'reseau'
    | 'telephone'
    | 'enveloppe'
    | 'whatsapp'
    | 'globe'
    | 'fleche';
  class?: string;
}

const { nom, class: classe = 'w-6 h-6' } = Astro.props;
---

{
  nom === 'education' && (
    <svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3 1.5 8.2 12 13.4l10.5-5.2L12 3Z" />
      <path d="M5.6 10.4v5.1c0 1.6 2.9 2.9 6.4 2.9s6.4-1.3 6.4-2.9v-5.1" />
      <path d="M21.4 8.7v5.6" />
    </svg>
  )
}

{
  nom === 'insertion' && (
    <svg class={classe} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="7.2" r="3.3" />
      <path d="M4.8 20.4a7.2 7.2 0 0 1 14.4 0" />
      <path d="M2.4 13.2c1.1-.9 2.3-1.3 3.6-1.3" />
      <path d="M21.6 13.2c-1.1-.9-2.3-1.3-3.6-1.3" />
