---
import Base from '../layouts/Base.astro';
import Vague from '../components/Vague.astro';
import Icone from '../components/Icone.astro';
import { contact, servicesMonture, mentionMonture } from '../data/site';

const messageWhatsApp = encodeURIComponent(
  'Bonjour, je souhaite prendre rendez-vous pour UP Monture.'
);
---

<Base
  titre="UP Monture"
  description="UP Monture, votre expert optique mobile : nettoyage et entretien de lunettes à domicile, montures tendance, mise en relation avec des opticiens et ophtalmologistes agréés."
>
  <section class="relative overflow-hidden bg-white">
    <div class="mx-auto max-w-4xl px-5 py-14 text-center lg:px-8 lg:py-20">
      <p class="text-sm font-semibold tracking-wide text-up-magenta">Un service Univers des Possibilités</p>
      <h1 class="titre-up mt-4 text-3xl sm:text-4xl lg:text-5xl">
        UP Monture<br />
        <span class="texte-degrade">votre expert optique mobile</span>
      </h1>
      <p class="prose-up mx-auto mt-6 text-lg text-up-gris">
        Nous nous déplaçons chez vous ou sur votre lieu de travail, pour les particuliers comme pour
        les entreprises.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={`https://wa.me/${contact.whatsapp}?text=${messageWhatsApp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bouton bouton-plein w-full sm:w-auto"
        >
          <Icone nom="whatsapp" class="h-4 w-4" />
          Prendre rendez-vous
        </a>
        <a href={`tel:${contact.telPrincipalBrut}`} class="bouton bouton-ligne w-full sm:w-auto">
          {contact.telPrincipal}
        </a>
      </div>
    </div>
  </section>

  <Vague sens="montante" couleur="brume" class="-mb-px" />

  <section class="bg-up-brume">
    <div class="mx-auto max-w-6xl px-5 py-14 lg:px-8 lg:py-20">
      <h2 class="titre-up text-center text-2xl sm:text-3xl">Ce que nous faisons</h2>

      <div class="mt-12 grid gap-7 md:grid-cols-3">
        {
          servicesMonture.map((service) => (
            <article class="flex flex-col rounded-3xl bg-white p-7 shadow-sm shadow-up-violet/5">
              <div class="medaillon h-20 w-20">
                <span>
                  <Icone nom={service.icone} class="h-10 w-10 text-up-violet" />
                </span>
              </div>
              <h3 class="titre-up mt-6 text-lg text-up-encre">{service.titre}</h3>
              <p class="mt-3 font-medium text-up-violet">{service.accroche}</p>
              <ul class="mt-5 space-y-2.5">
                {service.details.map((detail) => (
                  <li class="flex items-start gap-3 text-sm leading-relaxed text-up-gris">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-up-magenta" />
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mention obligatoire : elle délimite le périmètre de l'activité. -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-5 py-12 lg:px-8 lg:py-16">
      <div class="rounded-2xl border-2 border-up-ligne bg-up-brume p-6 sm:p-7">
        <h2 class="titre-up text-base text-up-violet">Bon à savoir</h2>
        <p class="mt-3 leading-relaxed text-up-encre">{mentionMonture}</p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-5 pb-16 text-center lg:px-8 lg:pb-20">
      <h2 class="titre-up text-2xl sm:text-3xl">Une question sur vos lunettes ?</h2>
      <p class="prose-up mx-auto mt-4 text-up-gris">
        Écrivez-nous sur WhatsApp, nous vous répondons et convenons d'un passage.
      </p>
      <a
        href={`https://wa.me/${contact.whatsapp}?text=${messageWhatsApp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="bouton bouton-plein mt-7"
      >
        <Icone nom="whatsapp" class="h-4 w-4" />
        Écrire sur WhatsApp
      </a>
    </div>
  </section>
</Base>
